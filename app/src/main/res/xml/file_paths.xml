<?xml version="1.0" encoding="utf-8"?>
<!--
  只暴露「更新用的 APK 缓存」和「已下载音频」两个子目录。
  不要开 root-path —— 那等于把整个私有目录都交给任何拿到 FileProvider 授权的应用。
-->
<paths>
    <cache-path name="updates" path="updates/" />
    <!-- 已下载的音频：分享时只暴露这一个子目录，不开整个 filesDir -->
    <files-path name="downloads" path="downloads/" />
</paths>
